      ["Sac Urban","Accessoires",49.99,"Sac au style contemporain.","photo-1548036328-c9fa89d128fa","SACS"],
      ["Portefeuille Minimal","Accessoires",24.99,"Portefeuille compact et épuré.","photo-1627123424574-724758594e93","ESSENTIEL"],
      ["Lunettes Premium","Accessoires",39.99,"Lunettes au style intemporel.","photo-1511499767150-a48a237f0083","STYLE"],
      ["Canapé Design","Maison",399.99,"Canapé contemporain pour ton intérieur.","photo-1555041469-a586c61ea9bc","MAISON"],
      ["Déco Maison","Maison",39.99,"Objet décoratif pour ton intérieur.","photo-1600210492486-724fe5c67fb0","DÉCO"],
      ["Lampe Maison","Maison",54.99,"Lampe moderne et élégante.","photo-1507473885765-e6ed057f782c","LUMIÈRE"],
      ["Table Basse","Maison",89.99,"Table basse au design minimaliste.","photo-1533090481720-856c6e3c1fdc","MOBILIER"],
      ["Plante Décorative","Maison",22.99,"Touche végétale pour ton espace.","photo-1485955900006-10f4d324d411","DÉCO"],
      ["Miroir Design","Maison",64.99,"Miroir décoratif contemporain.","photo-1618221195710-dd6b41faaea6","DÉCO"]
    ];

    let currentFilter = "Tous";
    let cart = [];

    function toggleSearch(){
      const panel = document.getElementById("searchPanel");
      panel.classList.toggle("open");
      if(panel.classList.contains("open")) document.getElementById("searchInput").focus();
      else { document.getElementById("searchInput").value=""; applySearch(); }
    }

    function setFilter(filter, button){
      currentFilter = filter;
      document.querySelectorAll(".filter").forEach(b=>b.classList.remove("active"));
      if(button) button.classList.add("active");
      document.getElementById("marketTitle").textContent = filter==="Tous" ? "À découvrir" : filter;
      document.getElementById("marketSubtitle").textContent = filter==="Tous" ? "Des nouveautés dans tous tes univers." : "Découvre notre sélection "+filter+".";
      renderProducts();
    }

    function openCategory(category){
      document.getElementById("hero").style.display="none";
      document.getElementById("categories").style.display="none";
      document.getElementById("shop").style.display="block";
      document.getElementById("seasonChoice").style.display=category==="LN FUSION"?"grid":"none";
      document.getElementById("categoryTitle").textContent=category==="LN FUSION"?"COLLECTIONS LN FUSION":category;
      document.getElementById("categoryDescription").textContent=category==="LN FUSION"?"Choisis ta collection hiver ou été.":"Découvre les produits de cette catégorie.";
      document.getElementById("marketplace").style.display=category==="LN FUSION"?"none":"block";
      document.getElementById("searchInput").value="";
      if(category!=="LN FUSION"){
        currentFilter=category;
        syncFilterButtons();
        document.getElementById("marketTitle").textContent=category;
        document.getElementById("marketSubtitle").textContent="Découvre notre sélection "+category+".";
        renderProducts();
      }
      window.scrollTo({top:0,behavior:"smooth"});
    }

    function openCollection(collection){
      document.getElementById("shop").style.display="block";
      document.getElementById("seasonChoice").style.display="none";
      document.getElementById("categoryTitle").textContent=collection;
      document.getElementById("categoryDescription").textContent="Découvre les modèles de cette collection.";
      document.getElementById("marketplace").style.display="block";
      currentFilter=collection;
      syncFilterButtons();
      document.getElementById("marketTitle").textContent=collection;
      document.getElementById("marketSubtitle").textContent="Les pièces de la collection "+collection+".";
      renderProducts();
      window.scrollTo({top:0,behavior:"smooth"});
    }

    function syncFilterButtons(){
      document.querySelectorAll(".filter").forEach(b=>{
        const label=b.textContent.trim();
        const map={"Tout":"Tous","LN Hiver":"LN FUSION HIVER","LN Été":"LN FUSION ÉTÉ","Tech":"Technologie"};
        b.classList.toggle("active",(map[label]||label)===currentFilter);
      });
    }

    function home(){
      currentFilter="Tous";
      document.getElementById("hero").style.display="flex";
      document.getElementById("categories").style.display="block";
      document.getElementById("shop").style.display="none";
      document.getElementById("marketplace").style.display="block";
      document.getElementById("marketTitle").textContent="À découvrir";
      document.getElementById("marketSubtitle").textContent="Des nouveautés dans tous tes univers.";
      document.getElementById("searchInput").value="";
      syncFilterButtons();
      renderProducts();
      window.scrollTo({top:0,behavior:"smooth"});
    }

    function applySearch(){
      renderProducts();
      document.getElementById("marketplace").style.display="block";
      if(document.getElementById("searchInput").value.trim()){
        document.getElementById("hero").style.display="none";
        document.getElementById("categories").style.display="none";
        document.getElementById("shop").style.display="none";
        document.getElementById("marketTitle").textContent="Résultats de recherche";
        document.getElementById("marketSubtitle").textContent="Voici les produits correspondant à ta recherche.";
      }
    }

    function renderProducts(){
      const query=document.getElementById("searchInput").value.trim().toLowerCase();
      let list=products.filter(p=>
        (currentFilter==="Tous" || p[1]===currentFilter) &&
        (p[0].toLowerCase().includes(query)||p[1].toLowerCase().includes(query)||p[3].toLowerCase().includes(query)||p[5].toLowerCase().includes(query))
      );
      const sort=document.getElementById("sortSelect").value;
      if(sort==="low") list.sort((a,b)=>a[2]-b[2]);
      if(sort==="high") list.sort((a,b)=>b[2]-a[2]);
      document.getElementById("products").innerHTML=list.map((p,i)=>`
        <article class="product">
          <div class="photo">
            <img src="https://images.unsplash.com/${p[4]}?auto=format&fit=crop&w=700&q=82" alt="${p[0]}" loading="lazy">
            <span class="product-tag">${p[5]}</span>
          </div>
          <div class="info">
            <div class="label">${p[1]}</div>
            <h3>${p[0]}</h3>
            <div class="desc">${p[3]}</div>
            <div class="price-row"><span class="price">${p[2].toFixed(2).replace(".",",")} €</span><span class="old-price">${(p[2]*1.18).toFixed(2).replace(".",",")} €</span></div>
            <div class="desc">Prix fictif – démonstration</div>
            <button class="add" onclick="addCart(${products.indexOf(p)})">AJOUTER AU PANIER +</button>
          </div>
        </article>`).join("");
      document.getElementById("empty").style.display=list.length?"none":"block";
    }

    function addCart(index){
      cart.push(products[index]);
      document.getElementById("count").textContent=cart.length;
      alert(products[index][0]+" ajouté au panier de démonstration !");
    }

    function showCart(){
      if(!cart.length){alert("Ton panier est vide !");return;}
      const total=cart.reduce((sum,p)=>sum+p[2],0);
      alert("PANIER LN FUSION (DÉMO)\n\n"+cart.map(p=>"• "+p[0]+" — "+p[2].toFixed(2).replace(".",",")+" €").join("\n")+"\n\nTotal fictif : "+total.toFixed(2).replace(".",",")+" €\n\nAucune commande ni aucun paiement réel n'est possible.");
    }

    renderProducts();
  </script>
</body>
</html>
